# Server
PORT=8080
ENV=dev                                   # dev | staging | prod
MIN_APP_VERSION=1.0.0                     # below this, 426 + force update
LOG_LEVEL=info

# Neon Postgres
# pooled: ordinary app queries (host has "-pooler")
DATABASE_URL=postgresql://app:***@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/bou?sslmode=require
# direct: River (LISTEN/NOTIFY) and migrations — PgBouncer transaction mode can't LISTEN
DATABASE_DIRECT_URL=postgresql://app:***@ep-xxx.ap-southeast-1.aws.neon.tech/bou?sslmode=require

# Neon Object Storage (from the Neon console, or `neon env pull`)
AWS_ENDPOINT_URL_S3=https://<branch-s3-endpoint>
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=***
AWS_SECRET_ACCESS_KEY=***
S3_BUCKET=bou-private

# Firebase (Auth + FCM)
FIREBASE_PROJECT_ID=bou-reminder-dev
FIREBASE_CREDENTIALS_JSON='{"type":"service_account",...}'
# Local dev with the Auth emulator:
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Monitoring
SENTRY_DSN=
